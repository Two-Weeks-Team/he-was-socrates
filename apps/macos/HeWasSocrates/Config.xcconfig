// Config.xcconfig — committed defaults for the HeWasSocrates target.
//
// Per-developer overrides (DEVELOPMENT_TEAM, etc.) live in Local.xcconfig,
// which is gitignored. Copy Local.xcconfig.example to Local.xcconfig and
// fill in your team ID, then re-run `make xcodeproj`.
//
// xcconfig evaluation order: later assignments win. The optional include
// MUST come AFTER the defaults below, so Local.xcconfig can override them.
// The trailing `?` makes the include OPTIONAL — xcodebuild will not error
// when Local.xcconfig is absent (e.g. in CI or on a fresh clone).

// Defaults — empty DEVELOPMENT_TEAM falls back to the team selected in
// Xcode's Account UI under Automatic signing.
DEVELOPMENT_TEAM =

// Per-developer overrides (gitignored).
#include? "Local.xcconfig"
