<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>CFBundleDisplayName</key>
	<string>He Was Socrates</string>

	<!-- PR-ι F18: CFBundleSpokenName tells VoiceOver how to pronounce
	     the app name in announcements. Without it VoiceOver reads
	     "Socrates" letter-perfect (mis-pronounced "soh-krayts"). With
	     this key it speaks the dictionary pronunciation. Apple Bundle
	     reference: developer.apple.com/documentation/bundleresources/
	     information_property_list/cfbundlespokenname -->
	<key>CFBundleSpokenName</key>
	<string>He Was SOCK-ruh-teez</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>

	<key>CFBundleVersion</key>
	<string>1</string>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.education</string>

	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Two-Weeks-Team. Apache-2.0 (code) + CC-BY-4.0 (content).</string>

	<key>NSMainStoryboardFile</key>
	<string></string>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSSupportsAutomaticTermination</key>
	<true/>

	<key>NSSupportsSuddenTermination</key>
	<true/>

	<!-- Localized in two languages, per SC4 i18n + design-approved.json M06. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>마이크는 당신의 질문을 듣기 위해서만 사용됩니다. 음성은 기기를 절대 떠나지 않습니다. (Microphone is used only to hear your question. Audio never leaves this device.)</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>음성 인식은 기기 안에서만 처리됩니다. 0 byte의 데이터도 외부로 전송되지 않습니다. (Speech recognition runs on-device only. Zero bytes leave this device.)</string>

	<!-- Out-of-scope permissions explicitly NOT requested. The keys are
	     omitted entirely so first-launch TCC prompts are minimized. -->

	<key>UIBackgroundModes</key>
	<array/>

	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Hardens the app against any accidental cloud call. We have no
		     legitimate egress, so deny everything. -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<false/>
	</dict>

	<key>LSUIElement</key>
	<false/>

	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Localization hint for App Store / system-level UI. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
</dict>
</plist>
