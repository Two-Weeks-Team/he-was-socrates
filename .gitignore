# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?

# Xcode / Swift
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.moved-aside
*.swp
*.lock
.swiftpm/
Package.resolved

# MLX / Model artifacts (do not commit). Anchor to repo root via leading slash
# so case-insensitive macOS filesystems don't accidentally match
# packages/SocraticEngine/Sources/SocraticEngine/Models/ — that's source code.
*.mlx
*.gguf
*.safetensors
*.bin
/models/
/checkpoints/

# Force-track engine source layer that lives at packages/.../Models/
!packages/SocraticEngine/Sources/SocraticEngine/Models/**

# Audio / Video / large media
*.wav
*.mp3
*.mp4
*.mov
*.aiff
demo-recordings/
!docs/video-script.md

# Test artifacts
TestResults/
.coverage
coverage/

# IDE
.vscode/
.idea/

# Env / Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
secrets/
*.pem
*.p12

# Per-developer Xcode signing override (DEVELOPMENT_TEAM etc.)
# The .example template IS committed; the real Local.xcconfig is local-only.
apps/macos/HeWasSocrates/Local.xcconfig

# xcodeproj is generated by xcodegen from project.yml — never tracked.
# Tracking would defeat the regeneration contract and conflict with the
# per-developer signing variations Local.xcconfig is meant to host.
# Run `make xcodeproj` after editing project.yml.
apps/macos/HeWasSocrates/HeWasSocrates.xcodeproj/

# Python (helper scripts only)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Node (if any tooling)
node_modules/
.pnpm-store/

# Logs
*.log
logs/

# Temporary
tmp/
temp/
.cache/

# Build venv (ephemeral, regenerate via make assets)
.venv-build/
.venv/

# Swift build artifacts (regenerable via `swift build`)
**/.build/

# PreviewForge plugin sentinel files (zero-byte, created by hooks)
runs/.last-check.*

# User-specific preview editor config (writable via /api/config)
assets/.preview-config.json

# Generated visualization PNGs (regenerable; HTML editor + canonical visemes are committed)
assets/preview/*.png

# Force-track the canonical asset manifest
!assets/.build-manifest.json
tools/oracles/
